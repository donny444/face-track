# FaceTrack docker-compose environment template.
# Copy to `.env` (in the same directory as docker-compose.yml) and adjust.
#
#   cp .env.docker.example .env
#
# Docker Compose automatically picks up `.env` from the project directory.

# ----- server -----
# How long an issued instructor JWT is valid (minutes).
JWT_TOKEN_TTL_MINUTES=60

# Domain suffix required on instructor / student email addresses.
VALID_EMAIL_DOMAIN=@kmitl.ac.th

# ----- web -----
# This is BAKED into the Next.js client bundle at build time. Rebuild the
# `web` image whenever you change it: `docker compose build web`.
#
# Use http://localhost/api when the nginx reverse proxy is running (default
# topology). Use http://localhost:8000 if you instead expose the server
# directly on the host. The docker DNS name `server` is not reachable from
# the browser.
NEXT_PUBLIC_SERVER_URL=http://localhost/api

# ----- secrets (NOT set here) -----
# These are provided as files, not env vars, because docker-compose mounts
# them as read-only secrets at /run/secrets/* in the container:
#
#   * server/firebase.json        - Firebase service-account JSON. Download
#                                   from the Firebase console and place at
#                                   ./server/firebase.json.
#   * secrets/jwt_secret.txt      - Single-line random string used as
#                                   JWT_SECRET_KEY. Generate with e.g.
#                                       python -c "import secrets; print(secrets.token_urlsafe(48))"
#                                   and write the result to
#                                   ./secrets/jwt_secret.txt.
#                                   A starter dummy lives in
#                                   ./secrets/jwt_secret.example.txt.
